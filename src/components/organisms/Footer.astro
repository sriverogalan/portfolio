---
import { site } from "../../data/site";
import { socialLinks } from "../../data/links";
import TextLink from "../atoms/TextLink.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-page flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <p class="font-display text-sm font-semibold tracking-tight text-ink">
        {site.name}
      </p>
      <p class="text-sm text-ink-faint">{site.role} · {site.location}</p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {
        socialLinks.map((link) => (
          <TextLink href={link.url} external={link.external} class="text-sm text-ink-soft">
            {link.label}
          </TextLink>
        ))
      }
    </nav>

    <p class="text-xs text-ink-faint">
      © {year} · Built with Astro &amp; GSAP
    </p>
  </div>
</footer>
