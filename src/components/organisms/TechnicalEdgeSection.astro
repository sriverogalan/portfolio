---
import { getSkillGroups } from "../../data/skills";
import SectionHeader from "../molecules/SectionHeader.astro";
import TechStackGroup from "../molecules/TechStackGroup.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const skillGroups = getSkillGroups(lang);
---

<section id="stack" class="section-pad" data-section-bg="default">
  <div class="container-page flex flex-col gap-14">
    <SectionHeader
      index="04"
      label={t("section.stack.label")}
      title={t("section.stack.title")}
      description={t("section.stack.description")}
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((group) => <TechStackGroup group={group} />)}
    </div>
  </div>
</section>
