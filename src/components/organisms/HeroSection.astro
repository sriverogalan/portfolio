---
import { getSite } from "../../data/site";
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";
import AnimatedHeading from "../atoms/AnimatedHeading.astro";
import CTAGroup from "../molecules/CTAGroup.astro";
import MagneticButton from "../molecules/MagneticButton.astro";
import InteractiveGrid from "../motion/InteractiveGrid.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const site = getSite(lang);
const t = useTranslations(lang);
---

<section id="top" class="relative flex min-h-svh flex-col justify-center overflow-hidden pt-24">
  <InteractiveGrid />

  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-bg to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-10 lg:grid-cols-12 lg:gap-x-14 xl:gap-x-16">
    <div class="flex flex-col gap-6 lg:col-span-7 lg:gap-8">
      <p
        class="text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-ink-faint"
        data-hero-item
      >
        {site.role}
        <span class="mx-2 text-ink/20" aria-hidden="true">/</span>
        {site.location}
      </p>

      <AnimatedHeading
        as="h1"
        text={site.tagline}
        class="font-display text-headline max-w-lg text-balance text-ink lg:max-w-xl"
      />

      <p class="max-w-md text-base leading-relaxed text-ink-soft sm:text-lg" data-hero-item>
        {site.heroText}
      </p>

      <div data-hero-item>
        <CTAGroup>
          <MagneticButton>
            <Button href="#work" variant="primary" size="lg" class="btn-shimmer">
              {t("hero.viewWork")}
              <Icon name="arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
            </Button>
          </MagneticButton>
          <Button href={`mailto:${site.email}`} variant="secondary" size="lg">
            {t("hero.getInTouch")}
            <Icon name="mail" size={18} class="transition-transform duration-300 group-hover:scale-110" />
          </Button>
        </CTAGroup>
      </div>
    </div>

    <div class="flex justify-center lg:col-span-5 lg:justify-end" data-hero-item>
      <figure class="hero-portrait relative aspect-square w-[min(100%,17.5rem)] overflow-hidden rounded-[2rem] border border-border bg-surface-soft shadow-[0_28px_70px_-36px_rgba(10,10,10,0.28)] sm:w-[19rem] lg:w-[22rem]">
        <img
          src="/assets/sergi-hero.jpg"
          srcset="/assets/sergi.jpg 460w, /assets/sergi-hero.jpg 720w, /assets/sergi@2x.jpg 920w"
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 19rem, 17.5rem"
          alt={site.name}
          width="720"
          height="720"
          class="h-full w-full object-cover object-[center_12%]"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-portrait {
    background-image:
      radial-gradient(60% 80% at 20% 10%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent),
      linear-gradient(160deg, var(--color-surface), var(--color-surface-soft));
  }
</style>
