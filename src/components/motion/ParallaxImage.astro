---
import { cn } from "../../utils/cn";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width, height, class: className } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading="lazy"
  decoding="async"
  data-parallax-target
  class:list={[cn("h-full w-full object-cover", className)]}
/>
