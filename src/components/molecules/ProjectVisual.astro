---
import type { Project } from "../../data/projects";
import { cn } from "../../utils/cn";
import ParallaxImage from "../motion/ParallaxImage.astro";

interface Props {
  project: Project;
  variant?: "browser" | "clean";
  class?: string;
}

const { project, variant = "browser", class: className } = Astro.props;
const initials = project.title
  .replace(/[^a-zA-Z0-9 ]/g, "")
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

<div
  class:list={[
    cn(
      "relative aspect-[16/10] w-full overflow-hidden rounded-xl border border-border bg-surface-soft",
      variant === "clean" && "rounded-2xl",
      className,
    ),
  ]}
>
  {
    project.visual === "screenshot" ? (
      variant === "browser" ? (
        <>
          <div class="relative z-10 flex h-7 shrink-0 items-center gap-1.5 border-b border-border bg-surface px-3">
            <span class="size-2 rounded-full bg-border-strong" />
            <span class="size-2 rounded-full bg-border-strong" />
            <span class="size-2 rounded-full bg-border-strong" />
          </div>
          <div class="absolute inset-x-0 bottom-0 top-7 overflow-hidden">
            <ParallaxImage
              src={project.image ?? ""}
              alt={`${project.title} interface preview`}
              class="absolute inset-0 h-[112%] w-full max-w-none object-cover object-top transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]"
            />
          </div>
        </>
      ) : (
        <div class="absolute inset-0 overflow-hidden">
          <ParallaxImage
            src={project.image ?? ""}
            alt={`${project.title} interface preview`}
            class="absolute inset-0 h-[112%] w-full max-w-none object-cover object-top transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
          />
        </div>
      )
    ) : project.visual === "icon" ? (
      <div class="project-mesh absolute inset-0 grid place-items-center p-8">
        <img
          src={project.image ?? ""}
          alt={`${project.title} icon`}
          class="pointer-events-none size-[7.5rem] shrink-0 object-contain rounded-[22%] shadow-[0_16px_40px_-18px_rgba(10,10,10,0.35)] transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
          width="120"
          height="120"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="project-mesh absolute inset-0 grid place-items-center">
        <span class="font-display text-[clamp(3rem,8vw,6rem)] font-semibold tracking-tight text-ink/10">
          {initials}
        </span>
      </div>
    )
  }
</div>

<style>
  .project-mesh {
    background-image:
      radial-gradient(60% 80% at 20% 10%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent),
      radial-gradient(50% 60% at 90% 80%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent),
      linear-gradient(160deg, var(--color-surface), var(--color-surface-soft));
  }
</style>
