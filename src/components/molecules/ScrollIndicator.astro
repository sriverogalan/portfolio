---
interface Props {
  label?: string;
  href?: string;
}

const { label = "Scroll", href = "#work" } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-ink-faint transition-colors duration-300 hover:text-ink"
>
  {label}
  <span class="relative flex h-9 w-5 justify-center overflow-hidden rounded-full border border-border-strong">
    <span class="mt-1.5 size-1 rounded-full bg-ink-soft motion-safe:animate-[scrollDot_1.8s_ease-in-out_infinite]"></span>
  </span>
</a>

<style>
  @keyframes scrollDot {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    60% { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }
</style>
