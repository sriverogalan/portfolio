---
import type { Project } from "../../data/projects";
import { cn } from "../../utils/cn";
import ProjectVisual from "./ProjectVisual.astro";
import ProjectMeta from "./ProjectMeta.astro";
import Pill from "../atoms/Pill.astro";
import Badge from "../atoms/Badge.astro";
import TextLink from "../atoms/TextLink.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

interface Props {
  project: Project;
  /** Featured rows use an alternating editorial layout on large screens. */
  featured?: boolean;
  /** Compact rows for secondary projects. */
  compact?: boolean;
  /** Zero-based index for featured numbering and alternating layout. */
  index?: number;
  class?: string;
}

const { project, featured = false, compact = false, index = 0, class: className } = Astro.props;
const links = project.links ?? [];
const displayIndex = String(index + 1).padStart(2, "0");
const reverse = index % 2 === 1;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const caseStudy = project.caseStudy;

const initials = project.title
  .replace(/[^a-zA-Z0-9 ]/g, "")
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const beats = caseStudy
  ? [
      { label: t("caseStudy.problem"), text: caseStudy.problem },
      { label: t("caseStudy.approach"), text: caseStudy.approach },
      { label: t("caseStudy.outcome"), text: caseStudy.outcome },
    ]
  : [];
---

{
  featured ? (
    <article
      class:list={[
        cn(
          "group grid gap-8 border-t border-border py-10 md:gap-10 md:py-14 lg:grid-cols-12 lg:items-center lg:gap-x-10",
          className,
        ),
      ]}
      data-reveal
    >
      <span
        class="font-display text-[clamp(2rem,4vw,2.75rem)] tabular-nums leading-none text-ink/10 lg:col-span-1"
        aria-hidden="true"
      >
        {displayIndex}
      </span>

      <div
        class:list={[
          cn(
            "flex flex-col gap-4 lg:col-span-5",
            reverse && "lg:col-start-8",
          ),
        ]}
      >
        <div class="flex flex-col gap-2">
          <h3 class="font-display text-title text-ink">{project.title}</h3>
          <ProjectMeta role={project.role} company={project.company} year={project.year} />
          {project.impact && <Badge variant="accent">{project.impact}</Badge>}
        </div>

        <p class="max-w-lg text-pretty text-base leading-relaxed text-ink-soft">
          {project.shortDescription}
        </p>

        <ul class="flex flex-wrap gap-x-2 gap-y-2">
          {project.technologies.map((tech) => (
            <li>
              <Pill>{tech}</Pill>
            </li>
          ))}
        </ul>

        {links.length > 0 && (
          <div class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
            {links.map((link) => (
              <TextLink href={link.url} external icon="arrow-up-right">
                {link.label}
              </TextLink>
            ))}
          </div>
        )}
      </div>

      <div
        class:list={[
          cn(
            "lg:col-span-6",
            reverse ? "lg:col-start-2 lg:row-start-1" : "lg:col-start-7",
          ),
        ]}
      >
        <ProjectVisual
          project={project}
          variant="clean"
          class="shadow-[0_24px_60px_-32px_rgba(10,10,10,0.22)] transition-[transform,box-shadow] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1 group-hover:shadow-[0_32px_70px_-28px_rgba(10,10,10,0.28)]"
        />
      </div>

      {beats.length > 0 && (
        <div class="lg:col-span-12 lg:col-start-1">
          <dl class="grid gap-6 border-t border-border/80 pt-8 sm:grid-cols-3 sm:gap-8">
            {beats.map((beat) => (
              <div class="flex flex-col gap-2">
                <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-ink-faint">
                  {beat.label}
                </dt>
                <dd class="text-sm leading-relaxed text-ink-soft md:text-[0.9375rem]">
                  {beat.text}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </article>
  ) : compact ? (
    <article
      class:list={[
        cn(
          "group grid gap-4 border-t border-border first:border-t-0 px-4 py-6 transition-colors duration-300 hover:bg-surface-soft/80 md:px-6 md:grid-cols-[auto_1fr_auto] md:items-center md:gap-6 md:py-7",
          className,
        ),
      ]}
      data-reveal
    >
      <div class="project-mesh flex size-14 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-soft md:size-16">
        <span class="font-display text-lg font-semibold tracking-tight text-ink/20">{initials}</span>
      </div>

      <div class="flex min-w-0 flex-col gap-2">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-display text-lg text-ink">{project.title}</h3>
          {project.year && (
            <span class="text-xs tabular-nums text-ink-faint md:hidden">{project.year}</span>
          )}
        </div>

        <p class="text-sm leading-relaxed text-ink-soft">{project.shortDescription}</p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          {project.impact && <Badge>{project.impact}</Badge>}
          <ul class="flex flex-wrap gap-x-1.5 gap-y-1">
            {project.technologies.slice(0, 3).map((tech) => (
              <li>
                <Pill variant="muted">{tech}</Pill>
              </li>
            ))}
            {project.technologies.length > 3 && (
              <li>
                <Pill variant="muted">+{project.technologies.length - 3}</Pill>
              </li>
            )}
          </ul>
        </div>
      </div>

      <div class="hidden flex-col items-end gap-2 md:flex">
        {project.year && (
          <span class="text-xs tabular-nums text-ink-faint">{project.year}</span>
        )}
        {links[0] && (
          <TextLink href={links[0].url} external icon="arrow-up-right">
            {links[0].label}
          </TextLink>
        )}
      </div>
    </article>
  ) : (
    <article
      class:list={[
        cn(
          "group flex flex-col gap-5 rounded-2xl border border-border bg-surface p-4 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-border-strong hover:shadow-[0_20px_50px_-28px_rgba(10,10,10,0.18)]",
          className,
        ),
      ]}
      data-reveal
    >
      <ProjectVisual project={project} />

      <div class="flex flex-1 flex-col gap-4">
        <div class="flex flex-col gap-2">
          <h3 class="font-display text-title text-ink">{project.title}</h3>
          <ProjectMeta role={project.role} company={project.company} year={project.year} />
          {project.impact && <p class="text-sm font-medium leading-snug text-ink">{project.impact}</p>}
        </div>

        <p class="text-pretty text-base leading-relaxed text-ink-soft">{project.shortDescription}</p>

        <ul class="flex flex-wrap gap-x-2 gap-y-2">
          {project.technologies.map((tech) => (
            <li>
              <Pill>{tech}</Pill>
            </li>
          ))}
        </ul>

        {links.length > 0 && (
          <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2">
            {links.map((link) => (
              <TextLink href={link.url} external icon="arrow-up-right">
                {link.label}
              </TextLink>
            ))}
          </div>
        )}
      </div>
    </article>
  )
}

<style>
  .project-mesh {
    background-image:
      radial-gradient(60% 80% at 20% 10%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent),
      radial-gradient(50% 60% at 90% 80%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent),
      linear-gradient(160deg, var(--color-surface), var(--color-surface-soft));
  }
</style>
