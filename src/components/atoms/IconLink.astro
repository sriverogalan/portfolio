---
import { cn } from "../../utils/cn";
import Icon from "./Icon.astro";
import type { IconName } from "../../data/links";

interface Props {
  href: string;
  label: string;
  icon: IconName;
  external?: boolean;
  class?: string;
}

const { href, label, icon, external = false, class: className } = Astro.props;

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  rel={rel}
  target={target}
  aria-label={label}
  title={label}
  class:list={[
    cn(
      "inline-flex size-10 items-center justify-center rounded-full border border-border bg-surface text-ink-soft transition-colors duration-300 hover:border-ink/30 hover:text-ink",
      className,
    ),
  ]}
>
  <Icon name={icon} size={18} />
</a>
